{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FindBackendInstance",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "RunCommandOnBackendInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:us-east-2:391742238993:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Name": "solo101-backend"
        }
      }
    },
    {
      "Sid": "UseShellScriptDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:us-east-2::document/AWS-RunShellScript"
    },
    {
      "Sid": "ReadDeploymentResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}
