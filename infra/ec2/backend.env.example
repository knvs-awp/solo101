# non-secret settings for /etc/solo101/backend.env
NODE_ENV=production
# cloudfront reaches the backend through the security group, which only allows
# cloudfront addresses on this port
HOST=0.0.0.0
PORT=3000
AWS_REGION=us-east-2
AWS_EC2_METADATA_V1_DISABLED=true
DATABASE_HOST=solo101-db.cnmg2waqwhtg.us-east-2.rds.amazonaws.com
DATABASE_NAME=solo101
DATABASE_USER=solo101_app
DATABASE_PASSWORD_PARAMETER=/solo101/prod/db-password
DATABASE_SSL_CA_FILE=/etc/solo101/global-bundle.pem
